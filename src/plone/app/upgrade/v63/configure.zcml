<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="plone"
    >

  <gs:upgradeSteps
      profile="Products.CMFPlone:plone"
      source="6299"
      destination="6300"
      >
    <!-- Plone 6.3.0a1 -->
    <gs:upgradeStep
        title="Miscellaneous"
        handler="..utils.null_upgrade_step"
        />
  </gs:upgradeSteps>

  <gs:upgradeSteps
      profile="Products.CMFPlone:plone"
      source="6300"
      destination="6301"
      >
    <gs:upgradeStep
        title="Register plone.app.contentrules as installed core add-on"
        handler=".alpha.install_contentrules_profile"
        />
  </gs:upgradeSteps>

</configure>
