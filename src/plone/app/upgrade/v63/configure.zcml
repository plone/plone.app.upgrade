<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="plone"
    >

  <gs:upgradeSteps
      profile="Products.CMFPlone:plone"
      source="6299"
      destination="6300"
      >
    <!-- Plone 6.3.0a1 -->
    <gs:upgradeStep
        title="Add the AVIF settings to the imaging control panel."
        handler=".alpha.add_avif_imaging_settings"
        />
  </gs:upgradeSteps>

</configure>
