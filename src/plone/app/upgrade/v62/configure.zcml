<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gs="http://namespaces.zope.org/genericsetup"
    i18n_domain="plone"
    >

  <include file="profiles.zcml" />

  <gs:upgradeSteps
      profile="Products.CMFPlone:plone"
      source="6199"
      destination="6200"
      >
    <!-- Plone 6.2.0a1 -->
    <gs:upgradeStep
        title="Make the condition for the external editor action safer."
        handler="..v61.final.make_external_editor_action_condition_safer"
        />
    <gs:upgradeStep
        title="Update TinyMCE toolbar button and menu."
        handler=".alpha.update_tinymce_toolbar_menu_styles"
        />
    <gs:upgradeStep
        title="Add TinyMCE license key."
        handler=".alpha.add_tinymce_license_key"
        />
    <gs:upgradeStep
        title="Install plone.app.layout if classic distribution is used."
        handler=".alpha.install_plone_app_layout"
        />

    <gs:upgradeDepends
        title="Register IClassicUISchema control panel."
        import_profile="plone.app.upgrade.v62:to_iclassicuischema"
        />
  </gs:upgradeSteps>

  <gs:upgradeSteps
      profile="Products.CMFPlone:plone"
      source="6200"
      destination="6201"
      >
    <!-- Plone 6.2.0rc1 -->
    <gs:upgradeStep
        title="Fix history action permission to CMFEditions: Access previous versions."
        handler=".alpha.fix_history_action_permission"
        />
    <gs:upgradeStep
        title="Add s tag to valid_tags for TinyMCE strikethrough support."
        handler=".alpha.add_s_to_valid_tags"
        />
  </gs:upgradeSteps>

  <gs:upgradeSteps
      profile="Products.CMFPlone:plone"
      source="6201"
      destination="6202"
      >
    <!-- Plone 6.2.0rc2 -->
    <gs:upgradeStep
        title="Add missing TinyMCE plugins to the registry record plone.plugins."
        handler=".alpha.add_missing_tinymce_plugin"
        />
  </gs:upgradeSteps>

</configure>
